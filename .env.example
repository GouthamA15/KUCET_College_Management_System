# ============================================================
# 1. ENVIRONMENT & RUNTIME
# ============================================================
NODE_ENV=development
NEXT_PUBLIC_WORKING_ENV=development

# ============================================================
# 2. DATABASE CONFIGURATION (TiDB / MySQL)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cms_user
DB_PASSWORD=cms_password
DB_DATABASE=kucet_cms
DB_SSL=false
# Persistent backup directory path (Default: /var/kucet-db-backup in prod, ./backups in dev)
DB_BACKUP_PATH=/var/kucet-db-backup

# ============================================================
# 3. AUTHENTICATION & SECURITY (Required)
# ============================================================
# JWT HMAC signing key (minimum 32 characters)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# Secret salt for digital certificate HMAC signing and verification
CERTIFICATE_SECRET=replace_with_certificate_secret_key

# AES-256-GCM encryption key for PII (Must be exactly 64-character hex string)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key_00000000000000000000

# ============================================================
# 4. CANONICAL APPLICATION URL
# ============================================================
# Canonical public base URL without trailing slash
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================
# 5. TRANSACTIONAL EMAIL (Categorized Brevo API & Sender Identities)
# ============================================================
# Authentication OTP
BREVO_API_KEY_AUTH_OTP=
BREVO_SENDER_EMAIL_AUTH_OTP=
BREVO_SENDER_NAME_AUTH_OTP=
# BREVO_REPLY_TO_EMAIL_AUTH_OTP=

# Password recovery
BREVO_API_KEY_PASSWORD_RECOVERY=
BREVO_SENDER_EMAIL_PASSWORD_RECOVERY=
BREVO_SENDER_NAME_PASSWORD_RECOVERY=
# BREVO_REPLY_TO_EMAIL_PASSWORD_RECOVERY=

# Account security alerts
BREVO_API_KEY_SECURITY_ALERTS=
BREVO_SENDER_EMAIL_SECURITY_ALERTS=
BREVO_SENDER_NAME_SECURITY_ALERTS=
# BREVO_REPLY_TO_EMAIL_SECURITY_ALERTS=

# Staff onboarding and activation
BREVO_API_KEY_STAFF_ONBOARDING=
BREVO_SENDER_EMAIL_STAFF_ONBOARDING=
BREVO_SENDER_NAME_STAFF_ONBOARDING=
# BREVO_REPLY_TO_EMAIL_STAFF_ONBOARDING=

# Admissions
BREVO_API_KEY_ADMISSIONS=
BREVO_SENDER_EMAIL_ADMISSIONS=
BREVO_SENDER_NAME_ADMISSIONS=
# BREVO_REPLY_TO_EMAIL_ADMISSIONS=

# Scholarship communications
BREVO_API_KEY_SCHOLARSHIP=
BREVO_SENDER_EMAIL_SCHOLARSHIP=
BREVO_SENDER_NAME_SCHOLARSHIP=
# BREVO_REPLY_TO_EMAIL_SCHOLARSHIP=

# System operations and backup failure alerts
BREVO_API_KEY_SYSTEM_OPERATIONS=
BREVO_SENDER_EMAIL_SYSTEM_OPERATIONS=
BREVO_SENDER_NAME_SYSTEM_OPERATIONS=
# BREVO_REPLY_TO_EMAIL_SYSTEM_OPERATIONS=

# Migration fallback configuration:
# Legacy shared sender address and key (retained during migration for backwards compatibility):
EMAIL_USER=admin@kucet.ac.in
BREVO_API_KEY=replace_with_brevo_api_key
# Set to 'true' during migration if category-specific credentials are temporarily absent:
ENABLE_LEGACY_BREVO_KEY_FALLBACK=false

# ============================================================
# 6. STORAGE PROVIDER STRATEGY
# ============================================================
# Supported: local | cloudinary | s3 | r2
# Defaults to local for self-hosted VPS production
STORAGE_PROVIDER=local
NEXT_PUBLIC_STORAGE_TYPE=local

# --- Local VPS Storage ---
# Absolute path inside the container (Docker maps host /var/www/kucet-storage to /app/storage)
# For local dev without Docker: leave empty or use ./public/uploads
LOCAL_STORAGE_PATH=/app/storage

# --- Cloudinary Storage (Required if STORAGE_PROVIDER=cloudinary) ---
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ============================================================
# 7. ASYNCHRONOUS QUEUE & WEBHOOKS (Upstash QStash)
# ============================================================
# Optional: Enables background processing (PDF generation, bulk imports, reports)
# If omitted, supported operations fall back safely to synchronous processing.
# QSTASH_URL=https://qstash.upstash.io
# QSTASH_TOKEN=your_qstash_token
# QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
# QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# ============================================================
# 8. DISTRIBUTED CACHE & RATE LIMITING (Upstash Redis)
# ============================================================
# Optional: Distributed cache and sliding-window rate limiting
# If omitted, falls back to in-memory cache and MySQL rate_limits table.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ============================================================
# 9. REAL-TIME ACTIVITY PULSE
# ============================================================
# Supported: socketio | redis | supabase | hybrid
# Defaults to socketio for self-hosted VPS production
REALTIME_PROVIDER=socketio

# --- Self-Hosted Socket.io & Redis (Authoritative for VPS) ---
REDIS_URL=redis://127.0.0.1:6379
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Supabase Realtime (Required if REALTIME_PROVIDER=supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================
# 10. ERROR MONITORING (Sentry)
# ============================================================
# Optional: Leave empty to disable Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ============================================================
# 11. WEB PUSH NOTIFICATIONS (VAPID)
# ============================================================
# Optional: Browser push notification support
# Generate keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_CONTACT_EMAIL=mailto:admin@kucet.ac.in

# ============================================================
# 12. INSTITUTIONAL STATIC ASSETS & CONFIGURATION
# ============================================================
NEXT_PUBLIC_SYLLABUS_BASE_URL=https://kucet.ac.in/pdf/syllabus

# ============================================================
# 13. EXPERIMENTAL COLLEGE EVENT SYSTEM (CHESS & TOURNAMENTS)
# ============================================================
# Isolated database for temporary college event tournaments.
# In local dev: defaults automatically to experiment_college_db on the local DB host.
# EXPERIMENT_DATABASE_URL=mysql://cms_user:cms_password@127.0.0.1:3306/experiment_college_db
EXPERIMENT_DB_HOST=127.0.0.1
EXPERIMENT_DB_PORT=3306
EXPERIMENT_DB_USER=cms_user
EXPERIMENT_DB_PASSWORD=cms_password
EXPERIMENT_DB_DATABASE=experiment_college_db
EXPERIMENT_DB_SSL=false
