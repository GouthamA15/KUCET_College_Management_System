# Database related credentials 
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=kucet_cms
DB_SSL=false
DB_BACKUP_PATH=/var/kucet-db-backup

# Email Configuration
EMAIL_USER=
BREVO_API_KEY=

# Secrets for JWT and Certificate
JWT_SECRET=
CERTIFICATE_SECRET=
ENCRYPTION_KEY=

# URLs for the application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Environment variable to specify the working environment
NEXT_PUBLIC_WORKING_ENV=development

# Cloudinary (Legacy Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Syllabus URL
NEXT_PUBLIC_SYLLABUS_BASE_URL=https://kucet.ac.in/pdf/syllabus

# Supabase (Optional Real-time fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# VPS Infrastructure (Real-time & Storage)
REDIS_URL=redis://127.0.0.1:6379
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_STORAGE_TYPE=cloudinary
LOCAL_STORAGE_PATH=/var/www/kucet-storage/uploads
