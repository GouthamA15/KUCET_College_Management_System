# ============================================================
# KUCET COLLEGE MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT TEMPLATE
# Instructions: Copy this file to .env.production on your VPS host,
# replace all placeholder values with actual production secrets,
# and ensure file permissions are restricted (e.g. chmod 600 .env.production).
# DO NOT COMMIT REAL PRODUCTION SECRETS INTO VERSION CONTROL.
# ============================================================

# ============================================================
# 1. RUNTIME ENVIRONMENT
# ============================================================
NODE_ENV=production
NEXT_PUBLIC_WORKING_ENV=production

# ============================================================
# 2. DATABASE CONFIGURATION (VPS MySQL)
# ============================================================
DB_HOST=db
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=kucet_cms
DB_SSL=true

# VPS Docker Compose Helper Variables (Used if running local database container)
DB_ROOT_PASSWORD=your_secure_root_password
DB_BACKUP_PATH=/var/kucet-db-backup

# ============================================================
# 3. AUTHENTICATION & SECURITY SECRETS (Required)
# ============================================================
# Generate strong secrets with: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
CERTIFICATE_SECRET=replace_with_strong_certificate_signing_secret
ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key_00000000000000000000

# ============================================================
# 4. CANONICAL APPLICATION URL
# ============================================================
# Canonical public HTTPS domain (Without trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-production-domain.example

# ============================================================
# 5. TRANSACTIONAL EMAIL (Categorized Brevo API & Sender Identities)
# ============================================================
# Authentication OTP
BREVO_API_KEY_AUTH_OTP=replace_with_brevo_api_key_auth_otp
BREVO_SENDER_EMAIL_AUTH_OTP=auth-otp@kucet.ac.in
BREVO_SENDER_NAME_AUTH_OTP=KUCET Authentication
# BREVO_REPLY_TO_EMAIL_AUTH_OTP=

# Password recovery
BREVO_API_KEY_PASSWORD_RECOVERY=replace_with_brevo_api_key_password_recovery
BREVO_SENDER_EMAIL_PASSWORD_RECOVERY=recovery@kucet.ac.in
BREVO_SENDER_NAME_PASSWORD_RECOVERY=KUCET Account Recovery
# BREVO_REPLY_TO_EMAIL_PASSWORD_RECOVERY=

# Account security alerts
BREVO_API_KEY_SECURITY_ALERTS=replace_with_brevo_api_key_security_alerts
BREVO_SENDER_EMAIL_SECURITY_ALERTS=security@kucet.ac.in
BREVO_SENDER_NAME_SECURITY_ALERTS=KUCET Security Alerts
# BREVO_REPLY_TO_EMAIL_SECURITY_ALERTS=

# Staff onboarding and activation
BREVO_API_KEY_STAFF_ONBOARDING=replace_with_brevo_api_key_staff_onboarding
BREVO_SENDER_EMAIL_STAFF_ONBOARDING=staff-onboarding@kucet.ac.in
BREVO_SENDER_NAME_STAFF_ONBOARDING=KUCET Staff Onboarding
# BREVO_REPLY_TO_EMAIL_STAFF_ONBOARDING=

# Admissions
BREVO_API_KEY_ADMISSIONS=replace_with_brevo_api_key_admissions
BREVO_SENDER_EMAIL_ADMISSIONS=admissions@kucet.ac.in
BREVO_SENDER_NAME_ADMISSIONS=KUCET Admissions Office
# BREVO_REPLY_TO_EMAIL_ADMISSIONS=

# Scholarship communications
BREVO_API_KEY_SCHOLARSHIP=replace_with_brevo_api_key_scholarship
BREVO_SENDER_EMAIL_SCHOLARSHIP=scholarship@kucet.ac.in
BREVO_SENDER_NAME_SCHOLARSHIP=KUCET Scholarship Section
# BREVO_REPLY_TO_EMAIL_SCHOLARSHIP=

# System operations and backup failure alerts
BREVO_API_KEY_SYSTEM_OPERATIONS=replace_with_brevo_api_key_system_operations
BREVO_SENDER_EMAIL_SYSTEM_OPERATIONS=operations@kucet.ac.in
BREVO_SENDER_NAME_SYSTEM_OPERATIONS=KUCET System Operations
# BREVO_REPLY_TO_EMAIL_SYSTEM_OPERATIONS=

# Migration fallback configuration:
# Legacy shared sender address and key (retained during migration for backwards compatibility):
EMAIL_USER=admin@kucet.ac.in
BREVO_API_KEY=replace_with_brevo_api_key
# Set to 'true' during migration if category-specific credentials are temporarily absent:
ENABLE_LEGACY_BREVO_KEY_FALLBACK=false

# ============================================================
# 6. STORAGE PROVIDER STRATEGY
# ============================================================
# Strategy: cloudinary | local | s3 | r2 (Default: cloudinary)
NEXT_PUBLIC_STORAGE_TYPE=local

# --- Cloudinary Configuration (When STORAGE_TYPE=cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Local VPS Storage Configuration (When STORAGE_TYPE=local) ---
# When running in Docker: /app/storage (Docker maps host /var/www/kucet-storage to /app/storage)
# When running directly on host without Docker: /var/www/kucet-storage
LOCAL_STORAGE_PATH=/app/storage

# --- S3 / Cloudflare R2 Configuration (When STORAGE_TYPE=s3 or r2) ---
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=kucet-uploads
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_s3_access_key
# S3_SECRET_ACCESS_KEY=your_s3_secret_key
# S3_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# ============================================================
# 7. ASYNCHRONOUS QUEUE & WEBHOOKS (Upstash QStash)
# ============================================================
# Optional: Offload background tasks (PDF generation, bulk imports, reports)
# If omitted, supported operations fall back safely to synchronous execution.
# QSTASH_URL=https://qstash.upstash.io
# QSTASH_TOKEN=your_qstash_token
# QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
# QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# ============================================================
# 8. DISTRIBUTED CACHE & RATE LIMITING (Upstash Redis)
# ============================================================
# Optional: High performance distributed cache & sliding-window rate limits
# If omitted, falls back to in-memory caching and MySQL rate_limits table.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ============================================================
# 9. REAL-TIME ACTIVITY PULSE
# ============================================================
# Self-hosted Redis & Socket.io for VPS
REDIS_URL=redis://redis:6379
NEXT_PUBLIC_SOCKET_URL=https://your-production-domain.example:4000

# Supabase Realtime fallback (Optional)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================
# 10. ERROR MONITORING (Sentry)
# ============================================================
# Optional: Real-time error alerting (Leave empty to disable)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ============================================================
# 11. WEB PUSH NOTIFICATIONS (VAPID)
# ============================================================
# Optional: Web Push notification delivery
# Generate keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_CONTACT_EMAIL=mailto:admin@kucet.ac.in

# ============================================================
# 12. INSTITUTIONAL STATIC ASSETS
# ============================================================
NEXT_PUBLIC_SYLLABUS_BASE_URL=https://kucet.ac.in/pdf/syllabus

# ============================================================
# 13. EXPERIMENTAL COLLEGE EVENT SYSTEM (CHESS & TOURNAMENTS)
# ============================================================
# Isolated database for temporary college event tournaments on VPS.
# Point to a dedicated experimental database instance or separate database credentials.
# EXPERIMENT_DATABASE_URL=mysql://your_user:your_password@db:3306/experiment_college_db
EXPERIMENT_DB_HOST=db
EXPERIMENT_DB_PORT=3306
EXPERIMENT_DB_USER=your_database_user
EXPERIMENT_DB_PASSWORD=your_database_password
EXPERIMENT_DB_DATABASE=experiment_college_db
EXPERIMENT_DB_SSL=false
