# --- PRODUCTION ENVIRONMENT VARIABLES ---
# Copy this to .env.production and fill in the values

NODE_ENV=production

# Database (Internal Docker Network)
DB_HOST=db
DB_PORT=3306
DB_USER=cms_user
DB_PASSWORD=cms_secure_password
DB_DATABASE=kucet_cms
DB_ROOT_PASSWORD=very_strong_root_password
DB_SSL=false
DB_BACKUP_PATH=/var/kucet-db-backup

# Email Configuration (Brevo)
EMAIL_USER=admin@kucet.ac.in
BREVO_API_KEY=your_brevo_api_key

# Secrets (Generate these using `openssl rand -hex 32`)
JWT_SECRET=your_long_jwt_secret
CERTIFICATE_SECRET=your_long_certificate_secret
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# URLs
NEXT_PUBLIC_BASE_URL=https://login.kucet.ac.in
NEXTAUTH_URL=https://login.kucet.ac.in

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_id
GOOGLE_CLIENT_SECRET=your_google_secret

# Infrastructure
REDIS_URL=redis://redis:6379
NEXT_PUBLIC_WORKING_ENV=production

# --- STORAGE STRATEGY ---
# Toggle between 'local' and 'cloudinary'
NEXT_PUBLIC_STORAGE_TYPE=local

# Required if STORAGE_TYPE=local
# Inside container path (mapped via docker-compose)
LOCAL_STORAGE_PATH=/var/www/kucet-storage/public

# Required if STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Supabase (If still using for Realtime)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
